MOCK_INTEGRATIONS=true
CALENDAR_DATA_SOURCE=mock
DISPATCH_DATA_SOURCE=mock
COMMAND_CENTRE_TRAINING_SAMPLES=false
DEFAULT_TIMEZONE=Australia/Melbourne
GRAPH_CALENDAR_TIMEZONE=Australia/Melbourne
# Local defaults. Set these three URLs to https://command.egit.com.au in production.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Command Centre

# Command Centre user login via Zoho OAuth/Auth.js.
DISABLE_AUTH=false
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com.au
ALLOWED_AUTH_EMAILS=simeon@egit.com.au,mattd@egit.com.au,jervy@egit.com.au,riley@egit.com.au

# Dedicated read-only wallboard login. Store only the generated scrypt hash.
WALLBOARD_LOCAL_USERNAME=
WALLBOARD_LOCAL_PASSWORD_HASH=

# Supabase Postgres connection string. Server-side only; use the pooled URL in Vercel.
DATABASE_URL=

# Legacy and connector-specific schedules may fall back to CRON_SECRET.
CRON_SECRET=

# Protects durable integration processing and scheduler setup.
# Generate a separate random value and keep it server-side only.
INTEGRATION_CRON_SECRET=

# Future MSP Central / helpdesk API service credentials.
MSP_CENTRAL_BASE_URL=
MSP_CENTRAL_PORTAL=
MSP_CENTRAL_CLIENT_ID=
MSP_CENTRAL_CLIENT_SECRET=
MSP_CENTRAL_REFRESH_TOKEN=
MSP_CENTRAL_REQUEST_WEB_BASE_URL=https://sdpod.mspcentral.manageengine.com.au/app/memsp1783593801295/ui/requests/{request}/details

# Future Microsoft Graph application credentials for Outlook calendar sync.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
COMMAND_CENTRE_NOTIFICATION_FROM_EMAIL=support@egit.com.au

# Zoho People leave read service. Keep separate from login and MSP Central OAuth.
# Required OAuth scope: ZOHOPEOPLE.leave.READ
ZOHO_PEOPLE_API_BASE_URL=https://people.zoho.com.au
ZOHO_PEOPLE_ACCOUNTS_URL=https://accounts.zoho.com.au
ZOHO_PEOPLE_CLIENT_ID=
ZOHO_PEOPLE_CLIENT_SECRET=
ZOHO_PEOPLE_REFRESH_TOKEN=

# Yeastar P-Series call reporting. Server-side only.
YEASTAR_BASE_URL=https://eastgippslandit.ras.yeastar.com
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
YEASTAR_WEBHOOK_SECRET=
YEASTAR_API_USER_AGENT=EGIT-Command-Centre/1.0

# Zoho CRM caller matching. Separate from login, MSP Central, and Zoho People.
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com.au
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com.au
